# Optional transactional email configuration for password recovery.
# Create a SMTP2GO account, verify a single sender email, then place the API key
# and sender address in Render's environment variables (never commit real keys).
SECRET_KEY=
SMTP2GO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=RUNOVER!
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60
API_TIMEOUT_SECONDS=15
