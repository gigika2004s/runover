# Export these variables in the shell/host. This file is not loaded automatically.
DATABASE_URL=sqlite:///./runover.db
# Generate a random value for production (do not use this example).
SECRET_KEY=replace-with-a-random-secret
MAIL_BACKEND=disabled
MAIL_FROM=
RESET_TOKEN_MINUTES=15
# Local Mailpit / SMTP:
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
# Gmail HTTPS / OAuth (no own domain required):
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
